# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local https certs from `next dev --experimental-https`
/certificates

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android / TWA
# The keystore IS your app's identity — losing it means you can never ship an
# update, and publishing it lets anyone sign as you. Never commit it.
*.keystore
*.jks
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/*.apk
android/*.aab
