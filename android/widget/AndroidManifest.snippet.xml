<!--
  Merge these two nodes into the <application> element of the AndroidManifest.xml
  that Bubblewrap generates at android/app/src/main/AndroidManifest.xml.

  Everything else in that file is Bubblewrap's and should be left alone.
-->

<!-- Sibling of <application>, not inside it. The widget fetches directly from
     this process, so it needs INTERNET; the TWA alone does not. -->
<uses-permission android:name="android.permission.INTERNET" />

<receiver
    android:name=".widget.TracoWidgetProvider"
    android:exported="false">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="app.vercel.traco_pi.twa.widget.REFRESH" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/traco_widget_info" />
</receiver>

<activity
    android:name=".widget.TracoWidgetConfigureActivity"
    android:exported="false"
    android:theme="@android:style/Theme.Material.Dialog.NoActionBar">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
    </intent-filter>
</activity>
